{
  "pluginAlias": "LegrandMyHome",
  "pluginType": "platform",
  "singular": false,
  "customUi": true,
  "headerDisplay": "Configure os dispositivos MyHome. Área zero é aceita. Matter disponível para relés MHRelay.",
  "schema": {
    "type": "object",
    "properties": {
      "name": { "type": "string", "title": "Nome" },
      "ipaddress": { "type": "string", "title": "Endereço do gateway", "required": true },
      "port": { "type": "integer", "title": "Porta", "default": 20000 },
      "ownpassword": { "type": "string", "title": "Senha do gateway" },
      "setclock": { "type": "boolean", "title": "Sincronizar relógio" },
      "devices": { "type": "array", "title": "Dispositivos", "items": {
        "type": "object", "properties": {
          "name": { "type": "string", "title": "Nome" },
          "accessory": { "type": "string", "title": "Tipo" },
          "address": { "type": "string", "title": "Endereço (barramento/área/ponto)" },
          "matter": { "type": "boolean", "title": "Publicar também no Matter", "default": false }
        }
      } }
    }
  }
}
