{
  "pluginAlias": "MyHomeOpenWebNet",
  "pluginType": "platform",
  "singular": true,
  "strictValidation": false,
  "schema": {
    "type": "object",
    "required": ["name", "host", "port"],
    "additionalProperties": false,
    "properties": {
      "name": {
        "title": "Nome do plugin",
        "type": "string",
        "default": "MyHome OpenWebNet",
        "required": true
      },
      "host": {
        "title": "IP do gateway MyHome",
        "type": "string",
        "placeholder": "192.168.0.23",
        "required": true
      },
      "port": {
        "title": "Porta OpenWebNet",
        "type": "integer",
        "default": 20000,
        "minimum": 1,
        "maximum": 65535,
        "required": true
      },
      "password": {
        "title": "Senha OpenWebNet",
        "type": "string",
        "default": "12345",
        "required": false
      },
      "lights": {
        "title": "Luzes",
        "description": "Adicione as luzes instaladas no sistema MyHome.",
        "type": "array",
        "minItems": 0,
        "items": {
          "type": "object",
          "title": "Luz",
          "required": ["name", "area", "point", "bus"],
          "additionalProperties": false,
          "properties": {
            "name": {
              "title": "Nome da luz",
              "type": "string",
              "placeholder": "Ex.: Luz da sala",
              "required": true
            },
            "area": {
              "title": "Ambiente (A)",
              "type": "integer",
              "minimum": 0,
              "maximum": 99,
              "required": true
            },
            "point": {
              "title": "Ponto de luz (PL)",
              "type": "integer",
              "minimum": 0,
              "maximum": 99,
              "required": true
            },
            "bus": {
              "title": "BUS (B)",
              "description": "Normalmente 0.",
              "type": "integer",
              "placeholder": "0",
              "minimum": 0,
              "maximum": 99,
              "required": true
            }
          }
        }
      },
      "dimmers": {
        "title": "Dimmers",
        "description": "Adicione as luzes com controle de intensidade.",
        "type": "array",
        "minItems": 0,
        "items": {
          "type": "object",
          "title": "Dimmer",
          "required": ["name", "area", "point", "bus"],
          "additionalProperties": false,
          "properties": {
            "name": {
              "title": "Nome do dimmer",
              "type": "string",
              "placeholder": "Ex.: Luz da sala",
              "required": true
            },
            "area": {
              "title": "Ambiente (A)",
              "type": "integer",
              "minimum": 0,
              "maximum": 99,
              "required": true
            },
            "point": {
              "title": "Ponto de luz (PL)",
              "type": "integer",
              "minimum": 0,
              "maximum": 99,
              "required": true
            },
            "bus": {
              "title": "BUS (B)",
              "description": "Normalmente 0.",
              "type": "integer",
              "placeholder": "0",
              "minimum": 0,
              "maximum": 99,
              "required": true
            }
          }
        }
      },
      "blinds": {
        "title": "Persianas comuns",
        "description": "Persianas sem posição absoluta, controladas pelo tempo de percurso.",
        "type": "array",
        "minItems": 0,
        "items": {
          "type": "object",
          "title": "Persiana comum",
          "required": ["name", "area", "point", "bus", "travelTime"],
          "additionalProperties": false,
          "properties": {
            "name": {
              "title": "Nome da persiana",
              "type": "string",
              "placeholder": "Ex.: Persiana da sala",
              "required": true
            },
            "area": {
              "title": "Ambiente (A)",
              "type": "integer",
              "minimum": 0,
              "maximum": 99,
              "required": true
            },
            "point": {
              "title": "Ponto (PL)",
              "type": "integer",
              "minimum": 0,
              "maximum": 99,
              "required": true
            },
            "bus": {
              "title": "BUS (B)",
              "description": "Normalmente 0.",
              "type": "integer",
              "placeholder": "0",
              "minimum": 0,
              "maximum": 99,
              "required": true
            },
            "travelTime": {
              "title": "Tempo total de percurso (segundos)",
              "description": "Tempo para abrir ou fechar completamente.",
              "type": "number",
              "placeholder": "30",
              "minimum": 1,
              "maximum": 600,
              "required": true
            },
            "invert": {
              "title": "Inverter subir e descer",
              "type": "boolean",
              "required": false
            }
          }
        }
      },
      "advancedBlinds": {
        "title": "Persianas avançadas",
        "description": "Persianas MyHome que informam e recebem posição absoluta de 0 a 100%.",
        "type": "array",
        "minItems": 0,
        "items": {
          "type": "object",
          "title": "Persiana avançada",
          "required": ["name", "area", "point", "bus"],
          "additionalProperties": false,
          "properties": {
            "name": {
              "title": "Nome da persiana",
              "type": "string",
              "placeholder": "Ex.: Persiana do quarto",
              "required": true
            },
            "area": {
              "title": "Ambiente (A)",
              "type": "integer",
              "minimum": 0,
              "maximum": 99,
              "required": true
            },
            "point": {
              "title": "Ponto (PL)",
              "type": "integer",
              "minimum": 0,
              "maximum": 99,
              "required": true
            },
            "bus": {
              "title": "BUS (B)",
              "description": "Normalmente 0.",
              "type": "integer",
              "placeholder": "0",
              "minimum": 0,
              "maximum": 99,
              "required": true
            }
          }
        }
      },
      "auxContacts": {
        "title": "Contatos secos (3477)",
        "description": "Entradas auxiliares configuradas para informar contato aberto ou fechado.",
        "type": "array",
        "minItems": 0,
        "items": {
          "type": "object",
          "title": "Contato seco",
          "required": ["name", "channel"],
          "additionalProperties": false,
          "properties": {
            "name": {
              "title": "Nome do contato",
              "type": "string",
              "placeholder": "Ex.: Porta da garagem",
              "required": true
            },
            "channel": {
              "title": "Canal AUX",
              "description": "Canal de 1 a 8 configurado no 3477.",
              "type": "integer",
              "minimum": 1,
              "maximum": 8,
              "required": true
            },
            "invert": {
              "title": "Inverter aberto e fechado",
              "type": "boolean",
              "required": false
            }
          }
        }
      },
      "cenPlusControls": {
        "title": "Comandos de cenário 4680 (CEN+)",
        "description": "Comandos HC/HD/HS/L/N/NT4680 configurados como Cenário programado PLUS.",
        "type": "array",
        "minItems": 0,
        "items": {
          "type": "object",
          "title": "Comando de cenário CEN+",
          "required": ["name", "cen"],
          "additionalProperties": false,
          "properties": {
            "name": {
              "title": "Nome do comando",
              "type": "string",
              "placeholder": "Ex.: Cenários da garagem",
              "required": true
            },
            "cen": {
              "title": "Número CEN",
              "description": "O mesmo número configurado no MyHomeSuite.",
              "type": "integer",
              "minimum": 1,
              "maximum": 2047,
              "required": true
            },
            "button1": {
              "title": "Nome do BT1",
              "type": "string",
              "placeholder": "BT1"
            },
            "button2": {
              "title": "Nome do BT2",
              "type": "string",
              "placeholder": "BT2"
            },
            "button3": {
              "title": "Nome do BT3",
              "type": "string",
              "placeholder": "BT3"
            },
            "button4": {
              "title": "Nome do BT4",
              "type": "string",
              "placeholder": "BT4"
            }
          }
        }
      }
    }
  },
  "layout": [
    "name",
    "host",
    {
      "key": "port",
      "type": "number",
      "title": "Porta OpenWebNet",
      "placeholder": "20000"
    },
    "password",
    {
      "key": "lights",
      "type": "array",
      "name": " ",
      "description": "Cadastre cada ponto de luz do sistema MyHome.",
      "orderable": true,
      "buttonText": "Adicionar luz",
      "items": [
        {
          "type": "div",
          "items": [
            {
              "key": "lights[].name",
              "title": "Nome da luz",
              "placeholder": "Nome da luz"
            },
            {
              "type": "div",
              "displayFlex": true,
              "flex-direction": "row",
              "items": [
                {
                  "key": "lights[].area",
                  "type": "number",
                  "flex": "1 1 120px",
                  "title": "Ambiente (A)"
                },
                {
                  "key": "lights[].point",
                  "type": "number",
                  "flex": "1 1 120px",
                  "title": "Ponto (PL)"
                },
                {
                  "key": "lights[].bus",
                  "type": "number",
                  "flex": "1 1 120px",
                  "title": "BUS (B)",
                  "description": ""
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "key": "dimmers",
      "type": "array",
      "name": " ",
      "description": "Cadastre cada dimmer do sistema MyHome.",
      "orderable": true,
      "buttonText": "Adicionar dimmer",
      "items": [
        {
          "type": "div",
          "items": [
            {
              "key": "dimmers[].name",
              "title": "Nome do dimmer",
              "placeholder": "Nome do dimmer"
            },
            {
              "type": "div",
              "displayFlex": true,
              "flex-direction": "row",
              "items": [
                {
                  "key": "dimmers[].area",
                  "type": "number",
                  "flex": "1 1 120px",
                  "title": "Ambiente (A)"
                },
                {
                  "key": "dimmers[].point",
                  "type": "number",
                  "flex": "1 1 120px",
                  "title": "Ponto (PL)"
                },
                {
                  "key": "dimmers[].bus",
                  "type": "number",
                  "flex": "1 1 120px",
                  "title": "BUS (B)",
                  "description": ""
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "key": "blinds",
      "type": "array",
      "name": " ",
      "description": "Cadastre persianas comuns e informe o tempo total de percurso.",
      "orderable": true,
      "buttonText": "Adicionar persiana comum",
      "items": [
        {
          "type": "div",
          "items": [
            {
              "key": "blinds[].name",
              "title": "Nome da persiana",
              "placeholder": "Nome da persiana"
            },
            {
              "type": "div",
              "displayFlex": true,
              "flex-direction": "row",
              "items": [
                {
                  "key": "blinds[].area",
                  "type": "number",
                  "flex": "1 1 95px",
                  "title": "Ambiente (A)"
                },
                {
                  "key": "blinds[].point",
                  "type": "number",
                  "flex": "1 1 95px",
                  "title": "Ponto (PL)"
                },
                {
                  "key": "blinds[].bus",
                  "type": "number",
                  "flex": "1 1 95px",
                  "title": "BUS (B)",
                  "description": ""
                },
                {
                  "key": "blinds[].travelTime",
                  "type": "number",
                  "flex": "1 1 120px",
                  "title": "Tempo (s)",
                  "description": ""
                },
                {
                  "key": "blinds[].invert",
                  "flex": "1 1 105px",
                  "title": "Inverter"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "key": "advancedBlinds",
      "type": "array",
      "name": " ",
      "description": "Cadastre persianas com controle e feedback de posição absoluta.",
      "orderable": true,
      "buttonText": "Adicionar persiana avançada",
      "items": [
        {
          "type": "div",
          "items": [
            {
              "key": "advancedBlinds[].name",
              "title": "Nome da persiana",
              "placeholder": "Nome da persiana"
            },
            {
              "type": "div",
              "displayFlex": true,
              "flex-direction": "row",
              "items": [
                {
                  "key": "advancedBlinds[].area",
                  "type": "number",
                  "flex": "1 1 120px",
                  "title": "Ambiente (A)"
                },
                {
                  "key": "advancedBlinds[].point",
                  "type": "number",
                  "flex": "1 1 120px",
                  "title": "Ponto (PL)"
                },
                {
                  "key": "advancedBlinds[].bus",
                  "type": "number",
                  "flex": "1 1 120px",
                  "title": "BUS (B)",
                  "description": ""
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "key": "auxContacts",
      "type": "array",
      "name": " ",
      "description": "Cadastre os canais AUX do contato seco 3477.",
      "orderable": true,
      "buttonText": "Adicionar contato seco",
      "items": [
        {
          "type": "div",
          "items": [
            {
              "key": "auxContacts[].name",
              "title": "Nome do contato",
              "placeholder": "Nome do contato"
            },
            {
              "type": "div",
              "displayFlex": true,
              "flex-direction": "row",
              "items": [
                {
                  "key": "auxContacts[].channel",
                  "type": "number",
                  "flex": "1 1 120px",
                  "title": "Canal AUX"
                },
                {
                  "key": "auxContacts[].invert",
                  "flex": "1 1 180px",
                  "title": "Inverter aberto/fechado"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "key": "cenPlusControls",
      "type": "array",
      "name": " ",
      "description": "Cadastre comandos 4680 configurados como Cenário programado PLUS.",
      "orderable": true,
      "buttonText": "Adicionar comando CEN+",
      "items": [
        {
          "type": "div",
          "items": [
            {
              "key": "cenPlusControls[].name",
              "title": "Nome do comando",
              "placeholder": "Nome do comando 4680"
            },
            {
              "type": "div",
              "displayFlex": true,
              "flex-direction": "row",
              "items": [
                {
                  "key": "cenPlusControls[].cen",
                  "type": "number",
                  "flex": "0 1 105px",
                  "title": "Número CEN"
                },
                {
                  "key": "cenPlusControls[].button1",
                  "flex": "1 1 130px",
                  "title": "Nome BT1"
                },
                {
                  "key": "cenPlusControls[].button2",
                  "flex": "1 1 130px",
                  "title": "Nome BT2"
                },
                {
                  "key": "cenPlusControls[].button3",
                  "flex": "1 1 130px",
                  "title": "Nome BT3"
                },
                {
                  "key": "cenPlusControls[].button4",
                  "flex": "1 1 130px",
                  "title": "Nome BT4"
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
