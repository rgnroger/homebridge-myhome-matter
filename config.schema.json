{
  "pluginAlias": "MyHomeMatter",
  "pluginType": "platform",
  "singular": true,
  "strictValidation": false,
  "schema": {
    "type": "object",
    "required": [
      "name",
      "host",
      "port"
    ],
    "additionalProperties": false,
    "properties": {
      "name": {
        "title": "Plugin name",
        "type": "string",
        "default": "MyHome Matter",
        "required": true
      },
      "host": {
        "title": "MyHome gateway IP address",
        "type": "string",
        "placeholder": "192.168.1.10",
        "required": true
      },
      "port": {
        "title": "OpenWebNet port",
        "type": "integer",
        "default": 20000,
        "minimum": 1,
        "maximum": 65535,
        "required": true
      },
      "password": {
        "title": "OpenWebNet password",
        "type": "string",
        "default": "",
        "required": false
      },
      "lights": {
        "title": "Lights",
        "description": "Add the lights installed in your MyHome system.",
        "type": "array",
        "minItems": 0,
        "items": {
          "type": "object",
          "title": "Light",
          "required": [
            "name",
            "area",
            "point",
            "bus"
          ],
          "additionalProperties": false,
          "properties": {
            "name": {
              "title": "Light name",
              "type": "string",
              "placeholder": "E.g. Living room light",
              "required": true
            },
            "area": {
              "title": "Area (A)",
              "type": "integer",
              "minimum": 0,
              "maximum": 99,
              "required": true
            },
            "point": {
              "title": "Light point (PL)",
              "type": "integer",
              "minimum": 0,
              "maximum": 99,
              "required": true
            },
            "bus": {
              "title": "BUS (B)",
              "description": "Normally 0.",
              "type": "integer",
              "placeholder": "0",
              "minimum": 0,
              "maximum": 99,
              "required": true
            },
            "matter": {
              "title": "Expose to Matter",
              "description": "Publish this light through the Matter bridge.",
              "type": "boolean",
              "default": false,
              "required": false
            }
          }
        }
      },
      "dimmers": {
        "title": "Dimmers",
        "description": "Add lights with brightness control.",
        "type": "array",
        "minItems": 0,
        "items": {
          "type": "object",
          "title": "Dimmer",
          "required": [
            "name",
            "area",
            "point",
            "bus"
          ],
          "additionalProperties": false,
          "properties": {
            "name": {
              "title": "Dimmer name",
              "type": "string",
              "placeholder": "E.g. Living room light",
              "required": true
            },
            "area": {
              "title": "Area (A)",
              "type": "integer",
              "minimum": 0,
              "maximum": 99,
              "required": true
            },
            "point": {
              "title": "Light point (PL)",
              "type": "integer",
              "minimum": 0,
              "maximum": 99,
              "required": true
            },
            "bus": {
              "title": "BUS (B)",
              "description": "Normally 0.",
              "type": "integer",
              "placeholder": "0",
              "minimum": 0,
              "maximum": 99,
              "required": true
            }
          }
        }
      },
      "blinds": {
        "title": "Standard blinds",
        "description": "Blinds without absolute position feedback, controlled using travel time.",
        "type": "array",
        "minItems": 0,
        "items": {
          "type": "object",
          "title": "Standard blind",
          "required": [
            "name",
            "area",
            "point",
            "bus",
            "travelTime"
          ],
          "additionalProperties": false,
          "properties": {
            "name": {
              "title": "Blind name",
              "type": "string",
              "placeholder": "E.g. Living room blind",
              "required": true
            },
            "area": {
              "title": "Area (A)",
              "type": "integer",
              "minimum": 0,
              "maximum": 99,
              "required": true
            },
            "point": {
              "title": "Point (PL)",
              "type": "integer",
              "minimum": 0,
              "maximum": 99,
              "required": true
            },
            "bus": {
              "title": "BUS (B)",
              "description": "Normally 0.",
              "type": "integer",
              "placeholder": "0",
              "minimum": 0,
              "maximum": 99,
              "required": true
            },
            "travelTime": {
              "title": "Total travel time (seconds)",
              "description": "Time required to open or close completely.",
              "type": "number",
              "placeholder": "30",
              "minimum": 1,
              "maximum": 600,
              "required": true
            },
            "invert": {
              "title": "Reverse up and down",
              "type": "boolean",
              "required": false
            }
          }
        }
      },
      "advancedBlinds": {
        "title": "Advanced blinds",
        "description": "MyHome blinds that report and accept an absolute position from 0 to 100%.",
        "type": "array",
        "minItems": 0,
        "items": {
          "type": "object",
          "title": "Advanced blind",
          "required": [
            "name",
            "area",
            "point",
            "bus"
          ],
          "additionalProperties": false,
          "properties": {
            "name": {
              "title": "Blind name",
              "type": "string",
              "placeholder": "E.g. Bedroom blind",
              "required": true
            },
            "area": {
              "title": "Area (A)",
              "type": "integer",
              "minimum": 0,
              "maximum": 99,
              "required": true
            },
            "point": {
              "title": "Point (PL)",
              "type": "integer",
              "minimum": 0,
              "maximum": 99,
              "required": true
            },
            "bus": {
              "title": "BUS (B)",
              "description": "Normally 0.",
              "type": "integer",
              "placeholder": "0",
              "minimum": 0,
              "maximum": 99,
              "required": true
            }
          }
        }
      },
      "auxContacts": {
        "title": "Dry contacts (3477)",
        "description": "Auxiliary inputs configured to report an open or closed contact.",
        "type": "array",
        "minItems": 0,
        "items": {
          "type": "object",
          "title": "Dry contact",
          "required": [
            "name",
            "channel"
          ],
          "additionalProperties": false,
          "properties": {
            "name": {
              "title": "Contact name",
              "type": "string",
              "placeholder": "E.g. Garage door",
              "required": true
            },
            "channel": {
              "title": "AUX channel",
              "description": "Channel 1 through 8 configured on the 3477.",
              "type": "integer",
              "minimum": 1,
              "maximum": 8,
              "required": true
            },
            "invert": {
              "title": "Reverse open and closed",
              "type": "boolean",
              "required": false
            }
          }
        }
      },
      "cenPlusControls": {
        "title": "4680 scenario controls (CEN+)",
        "description": "HC/HD/HS/L/N/NT4680 controls configured as Programmed Scenario PLUS.",
        "type": "array",
        "minItems": 0,
        "items": {
          "type": "object",
          "title": "CEN+ scenario control",
          "required": [
            "name",
            "cen"
          ],
          "additionalProperties": false,
          "properties": {
            "name": {
              "title": "Control name",
              "type": "string",
              "placeholder": "E.g. Garage scenarios",
              "required": true
            },
            "cen": {
              "title": "CEN number",
              "description": "The same number configured in MyHomeSuite.",
              "type": "integer",
              "minimum": 1,
              "maximum": 2047,
              "required": true
            },
            "button1": {
              "title": "BT1 name",
              "type": "string",
              "placeholder": "BT1"
            },
            "button2": {
              "title": "BT2 name",
              "type": "string",
              "placeholder": "BT2"
            },
            "button3": {
              "title": "BT3 name",
              "type": "string",
              "placeholder": "BT3"
            },
            "button4": {
              "title": "BT4 name",
              "type": "string",
              "placeholder": "BT4"
            }
          }
        }
      }
    }
  },
  "layout": [
    "name",
    "host",
    {
      "key": "port",
      "type": "number",
      "title": "OpenWebNet port",
      "placeholder": "20000"
    },
    "password",
    {
      "key": "lights",
      "type": "array",
      "name": " ",
      "description": "Add each light point in the MyHome system.",
      "orderable": true,
      "buttonText": "Add light",
      "items": [
        {
          "type": "div",
          "items": [
            {
              "key": "lights[].name",
              "title": "Light name",
              "placeholder": "Light name"
            },
            {
              "type": "div",
              "displayFlex": true,
              "flex-direction": "row",
              "items": [
                {
                  "key": "lights[].area",
                  "type": "number",
                  "flex": "1 1 120px",
                  "title": "Area (A)"
                },
                {
                  "key": "lights[].point",
                  "type": "number",
                  "flex": "1 1 120px",
                  "title": "Point (PL)"
                },
                {
                  "key": "lights[].bus",
                  "type": "number",
                  "flex": "1 1 120px",
                  "title": "BUS (B)",
                  "description": ""
                }
              ]
            },
            {
              "key": "lights[].matter",
              "type": "checkbox",
              "title": "Expose to Matter",
              "description": "Publish this light through the Matter bridge."
            }
          ]
        }
      ]
    },
    {
      "key": "dimmers",
      "type": "array",
      "name": " ",
      "description": "Add each dimmer in the MyHome system.",
      "orderable": true,
      "buttonText": "Add dimmer",
      "items": [
        {
          "type": "div",
          "items": [
            {
              "key": "dimmers[].name",
              "title": "Dimmer name",
              "placeholder": "Dimmer name"
            },
            {
              "type": "div",
              "displayFlex": true,
              "flex-direction": "row",
              "items": [
                {
                  "key": "dimmers[].area",
                  "type": "number",
                  "flex": "1 1 120px",
                  "title": "Area (A)"
                },
                {
                  "key": "dimmers[].point",
                  "type": "number",
                  "flex": "1 1 120px",
                  "title": "Point (PL)"
                },
                {
                  "key": "dimmers[].bus",
                  "type": "number",
                  "flex": "1 1 120px",
                  "title": "BUS (B)",
                  "description": ""
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "key": "blinds",
      "type": "array",
      "name": " ",
      "description": "Add standard blinds and enter their total travel time.",
      "orderable": true,
      "buttonText": "Add standard blind",
      "items": [
        {
          "type": "div",
          "items": [
            {
              "key": "blinds[].name",
              "title": "Blind name",
              "placeholder": "Blind name"
            },
            {
              "type": "div",
              "displayFlex": true,
              "flex-direction": "row",
              "items": [
                {
                  "key": "blinds[].area",
                  "type": "number",
                  "flex": "1 1 95px",
                  "title": "Area (A)"
                },
                {
                  "key": "blinds[].point",
                  "type": "number",
                  "flex": "1 1 95px",
                  "title": "Point (PL)"
                },
                {
                  "key": "blinds[].bus",
                  "type": "number",
                  "flex": "1 1 95px",
                  "title": "BUS (B)",
                  "description": ""
                },
                {
                  "key": "blinds[].travelTime",
                  "type": "number",
                  "flex": "1 1 120px",
                  "title": "Travel time (s)",
                  "description": ""
                },
                {
                  "key": "blinds[].invert",
                  "flex": "1 1 105px",
                  "title": "Reverse"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "key": "advancedBlinds",
      "type": "array",
      "name": " ",
      "description": "Add blinds with absolute position control and feedback.",
      "orderable": true,
      "buttonText": "Add advanced blind",
      "items": [
        {
          "type": "div",
          "items": [
            {
              "key": "advancedBlinds[].name",
              "title": "Blind name",
              "placeholder": "Blind name"
            },
            {
              "type": "div",
              "displayFlex": true,
              "flex-direction": "row",
              "items": [
                {
                  "key": "advancedBlinds[].area",
                  "type": "number",
                  "flex": "1 1 120px",
                  "title": "Area (A)"
                },
                {
                  "key": "advancedBlinds[].point",
                  "type": "number",
                  "flex": "1 1 120px",
                  "title": "Point (PL)"
                },
                {
                  "key": "advancedBlinds[].bus",
                  "type": "number",
                  "flex": "1 1 120px",
                  "title": "BUS (B)",
                  "description": ""
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "key": "auxContacts",
      "type": "array",
      "name": " ",
      "description": "Add the AUX channels of the 3477 dry-contact module.",
      "orderable": true,
      "buttonText": "Add dry contact",
      "items": [
        {
          "type": "div",
          "items": [
            {
              "key": "auxContacts[].name",
              "title": "Contact name",
              "placeholder": "Contact name"
            },
            {
              "type": "div",
              "displayFlex": true,
              "flex-direction": "row",
              "items": [
                {
                  "key": "auxContacts[].channel",
                  "type": "number",
                  "flex": "1 1 120px",
                  "title": "AUX channel"
                },
                {
                  "key": "auxContacts[].invert",
                  "flex": "1 1 180px",
                  "title": "Reverse open/closed"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "key": "cenPlusControls",
      "type": "array",
      "name": " ",
      "description": "Add 4680 controls configured as Programmed Scenario PLUS.",
      "orderable": true,
      "buttonText": "Add CEN+ control",
      "items": [
        {
          "type": "div",
          "items": [
            {
              "key": "cenPlusControls[].name",
              "title": "Control name",
              "placeholder": "4680 control name"
            },
            {
              "type": "div",
              "displayFlex": true,
              "flex-direction": "row",
              "items": [
                {
                  "key": "cenPlusControls[].cen",
                  "type": "number",
                  "flex": "0 1 105px",
                  "title": "CEN number"
                },
                {
                  "key": "cenPlusControls[].button1",
                  "flex": "1 1 130px",
                  "title": "BT1 name"
                },
                {
                  "key": "cenPlusControls[].button2",
                  "flex": "1 1 130px",
                  "title": "BT2 name"
                },
                {
                  "key": "cenPlusControls[].button3",
                  "flex": "1 1 130px",
                  "title": "BT3 name"
                },
                {
                  "key": "cenPlusControls[].button4",
                  "flex": "1 1 130px",
                  "title": "BT4 name"
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
