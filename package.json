{
  "name": "homebridge-myhome-openwebnet",
  "displayName": "Bticino/Legrand MyHome OpenWebNet",
  "version": "1.0.4",
  "description": "Homebridge plugin for Bticino/Legrand MyHome OpenWebNet systems, with support for lights, dimmers, blinds, 3477 dry contacts and 4680 CEN+ controls.",
  "main": "index.js",
  "type": "commonjs",
  "files": [
    "index.js",
    "lib",
    "config.schema.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node --check index.js && node --check lib/config.js && node --check lib/mhclient.js && node --check tools/mock-openwebnet-gateway.js",
    "test": "node --test",
    "test:watch": "node --test --watch",
    "test:gateway": "node tools/mock-openwebnet-gateway.js",
    "prepublishOnly": "npm test && npm run build"
  },
  "keywords": [
    "homebridge-plugin",
    "homebridge",
    "homebridge2",
    "supports-hap",
    "bticino",
    "bticino myhome",
    "legrand",
    "legrand myhome",
    "myhome",
    "my home",
    "my-home",
    "myhome openwebnet",
    "bus",
    "bus-scs",
    "scs",
    "openwebnet",
    "open web net",
    "homekit"
  ],
  "author": "rgnroger",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rgnroger/homebridge-myhome-openwebnet.git"
  },
  "bugs": {
    "url": "https://github.com/rgnroger/homebridge-myhome-openwebnet/issues"
  },
  "homepage": "https://github.com/rgnroger/homebridge-myhome-openwebnet#readme",
  "engines": {
    "node": ">=18.0.0",
    "homebridge": ">=1.6.0"
  },
  "dependencies": {
    "correcting-interval": "^2.0.0",
    "debug": "^2.4.5",
    "fakegato-history": "^0.5.6",
    "moment": "^2.18.1",
    "net": "^1.0.0",
    "sha256": "^0.2.0",
    "sprintf-js": "^1.0.3"
  }
}
